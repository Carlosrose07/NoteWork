@page "/proyectos/{ProyectoId:guid}/nodos"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using NoteWork.Shared.Entidades
@using NoteWork.Shared.Proyecto
@using NoteWork.Client.Servicios
@inject ServicioNodos ServicioNodos
@inject ServicioProyectos ServicioProyectos
@inject NavigationManager NavigationManager

<PageTitle>Desglose del Proyecto - NoteWork</PageTitle>

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-0 text-primary fw-bold">@(proyecto?.Nombre ?? "Cargando proyecto...")</h2>
            <small class="text-muted">Desglose de Pisos, Apartamentos y Áreas</small>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="VolverAProyectos">
                Volver a Proyectos
            </button>
            <a href="/proyecto/@ProyectoId/resumen" class="btn btn-success btn-sm shadow-sm">
                Ver Resumen General
            </a>
            <button type="button" class="btn btn-primary btn-sm" @onclick="() => AbrirFormularioCrear(null)">
                + Nivel Principal
            </button>
        </div>
    </div>
    <hr />

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger py-2">@mensajeError</div>
    }

    @* Formulario inline (liviano para celulares, sin modales pesados de JS) *@
    @if (mostrandoFormulario)
    {
        <div class="card mb-4 shadow-sm" style="border: 1px solid #d4e4ff;">
            <div class="card-header fw-bold text-primary" style="background-color: #eef5ff; border-bottom: 1px solid #d4e4ff;">
                @(nodoEditandoId.HasValue ? "Editar Nivel" : (nombrePadreFormulario != null ? $"Agregar dentro de: {nombrePadreFormulario}" : "Nuevo Nivel Principal"))
            </div>
            <div class="card-body">
                <EditForm Model="modeloFormulario" OnValidSubmit="GuardarNodoAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold mb-1">Tipo de Nivel</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="modeloFormulario.Tipo">
                                <option value="@TipoNodo.Piso">Piso</option>
                                <option value="@TipoNodo.Apartamento">Apartamento</option>
                                <option value="@TipoNodo.Area">Área</option>
                            </InputSelect>
                        </div>

                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-semibold mb-1">Nombre (ej. Piso 1, Apto 1A, Cocina)</label>
                            <InputText class="form-control form-control-sm" @bind-Value="modeloFormulario.Nombre" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Orden</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="modeloFormulario.Orden" />
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-sm px-3" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="CerrarFormulario" disabled="@guardando">
                            Cancelar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (nodosRaiz == null)
    {
        <div class="text-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Cargando estructura del proyecto...</p>
        </div>
    }
    else if (nodosRaiz.Count == 0)
    {
        <div class="alert alert-light border text-center py-4">
            <p class="mb-1 fw-semibold">Este proyecto aún no tiene niveles registrados.</p>
            <small class="text-muted">Usa "+ Nivel Principal" para agregar Pisos, Apartamentos o Áreas.</small>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-5">
            @foreach (var nodo in nodosRaiz)
            {
                @RenderizarNodo(nodo, 0)
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid ProyectoId { get; set; }

    private ProyectoEditarDto? proyecto;
    private List<NodoDto>? nodosRaiz;
    private string? mensajeError;

    // Estado del formulario de creación / edición
    private bool mostrandoFormulario = false;
    private bool guardando = false;
    private Guid? nodoEditandoId = null;
    private string? nombrePadreFormulario = null;
    private NodoGuardarDto modeloFormulario = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        mensajeError = null;
        proyecto = await ServicioProyectos.ObtenerProyectoPorIdAsync(ProyectoId);
        nodosRaiz = await ServicioNodos.ObtenerNodosPorProyectoAsync(ProyectoId) ?? new List<NodoDto>();
    }

    private RenderFragment RenderizarNodo(NodoDto nodo, int nivelProfundidad) => __builder =>
    {
        var margenIzqPx = nivelProfundidad * 16;
        var fondoTarjeta = nivelProfundidad == 0 ? "#eef5ff" : (nivelProfundidad == 1 ? "#f7faff" : "#ffffff");

        <div class="p-3 rounded shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2"
             style="margin-left: @(margenIzqPx)px; background-color: @fondoTarjeta; border: 1px solid #d4e4ff;">
            <div style="min-width: 0;">
                <span class="badge @ObtenerClaseBadge(nodo.Tipo) me-2">@nodo.Tipo</span>
                <strong class="text-break">@nodo.Nombre</strong>
                <small class="text-muted ms-2">(@nodo.TotalPartidas partidas)</small>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <strong class="text-success me-2 text-nowrap" style="font-size: 1.05em;">
                    $@nodo.Subtotal.ToString("N2")
                </strong>

                <div class="btn-group btn-group-sm">
                    @if (nodo.Tipo == TipoNodo.Area)
                    {
                        <button type="button" class="btn btn-outline-success" @onclick="() => IrAPartidas(nodo.Id)">
                            Partidas
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="() => AbrirFormularioCrear(nodo)">
                            + Subnivel
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => AbrirFormularioEditar(nodo)">
                        Editar
                    </button>
                    <button type="button" class="btn btn-outline-danger" @onclick="() => EliminarNodoAsync(nodo.Id)">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>

        @if (nodo.Hijos != null && nodo.Hijos.Count > 0)
        {
            foreach (var hijo in nodo.Hijos)
            {
                @RenderizarNodo(hijo, nivelProfundidad + 1)
            }
        }
    };

    private string ObtenerClaseBadge(TipoNodo tipo) => tipo switch
    {
        TipoNodo.Piso => "bg-dark",
        TipoNodo.Apartamento => "bg-info text-dark",
        TipoNodo.Area => "bg-success",
        _ => "bg-secondary"
    };

    private void AbrirFormularioCrear(NodoDto? padre)
    {
        mensajeError = null;
        nodoEditandoId = null;
        nombrePadreFormulario = padre?.Nombre;

        // Sugerimos el siguiente tipo lógico según el padre
        var tipoSugerido = padre == null
            ? (proyecto?.Tipo == TipoProyecto.Edificio ? TipoNodo.Piso : TipoNodo.Area)
            : (padre.Tipo == TipoNodo.Piso ? TipoNodo.Apartamento : TipoNodo.Area);

        modeloFormulario = new NodoGuardarDto
        {
            ProyectoId = ProyectoId,
            PadreId = padre?.Id,
            Tipo = tipoSugerido,
            Nombre = string.Empty,
            Orden = (padre?.Hijos.Count ?? nodosRaiz?.Count ?? 0) + 1
        };

        mostrandoFormulario = true;
    }

    private void AbrirFormularioEditar(NodoDto nodo)
    {
        mensajeError = null;
        nodoEditandoId = nodo.Id;
        nombrePadreFormulario = null;

        modeloFormulario = new NodoGuardarDto
        {
            ProyectoId = nodo.ProyectoId,
            PadreId = nodo.PadreId,
            Tipo = nodo.Tipo,
            Nombre = nodo.Nombre,
            Orden = nodo.Orden
        };

        mostrandoFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrandoFormulario = false;
        nodoEditandoId = null;
        nombrePadreFormulario = null;
    }

    private async Task GuardarNodoAsync()
    {
        guardando = true;
        mensajeError = null;

        if (nodoEditandoId.HasValue)
        {
            var (exito, error) = await ServicioNodos.EditarNodoAsync(nodoEditandoId.Value, modeloFormulario);
            if (exito)
            {
                mostrandoFormulario = false;
                await CargarDatosAsync();
            }
            else
            {
                mensajeError = error;
            }
        }
        else
        {
            var (exito, error) = await ServicioNodos.CrearNodoAsync(modeloFormulario);
            if (exito)
            {
                mostrandoFormulario = false;
                await CargarDatosAsync();
            }
            else
            {
                mensajeError = error;
            }
        }

        guardando = false;
    }

    private async Task EliminarNodoAsync(Guid id)
    {
        mensajeError = null;
        var (exito, error) = await ServicioNodos.EliminarNodoAsync(id);
        if (exito)
        {
            await CargarDatosAsync();
        }
        else
        {
            mensajeError = error;
        }
    }

    private void IrAPartidas(Guid nodoId)
    {
        NavigationManager.NavigateTo($"/nodos/{nodoId}/partidas");
    }

    private void VolverAProyectos()
    {
        NavigationManager.NavigateTo("/proyectos");
    }
}