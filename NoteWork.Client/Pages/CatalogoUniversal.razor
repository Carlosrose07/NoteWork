@page "/catalogo"
@using Microsoft.AspNetCore.Authorization
@using NoteWork.Shared.Dtos
@using NoteWork.Shared.Entidades.Universal
@using NoteWork.Shared.Motor
@using NoteWork.Client.Servicios

@attribute [Authorize(Roles = "Admin")]

@inject ServicioCatalogoUniversal ServicioCatalogo

<PageTitle>Catálogo Universal - NoteWork</PageTitle>

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-0 text-primary fw-bold">Catálogo Universal</h2>
            <small class="text-muted">Precios de materiales, mano de obra, márgenes y reglas (Solo Admin)</small>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm"
                @onclick="() => CargarCatalogoAsync(forzar: true)" disabled="@_cargando">
            Recargar
        </button>
    </div>
    <hr />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 d-flex justify-content-between align-items-center" role="alert">
            <span>@_error</span>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _error = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensajeOk))
    {
        <div class="alert alert-success py-2 d-flex justify-content-between align-items-center" role="alert">
            <span>@_mensajeOk</span>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _mensajeOk = null"></button>
        </div>
    }

    @if (_cargando && _paquete is null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Cargando catálogo...</p>
        </div>
    }
    else if (_paquete is not null)
    {
        @* Pestañas principales *@
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="button"
                    class="btn @(_pestana == PestanaCatalogo.Materiales ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => _pestana = PestanaCatalogo.Materiales">
                Materiales (@_paquete.Materials.Count)
            </button>
            <button type="button"
                    class="btn @(_pestana == PestanaCatalogo.Modelos ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => _pestana = PestanaCatalogo.Modelos">
                Modelos (@_paquete.Models.Count)
            </button>
        </div>

        @* ===================================================================== *@
        @* PESTAÑA 1: MATERIALES Y PRECIOS                                       *@
        @* ===================================================================== *@
        @if (_pestana == PestanaCatalogo.Materiales)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="d-flex flex-wrap gap-1">
                    <button type="button"
                            class="btn btn-sm @(_filtroTipoMaterial is null ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => _filtroTipoMaterial = null">
                        Todos
                    </button>
                    <button type="button"
                            class="btn btn-sm @(_filtroTipoMaterial == MaterialType.Linear1D ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => _filtroTipoMaterial = MaterialType.Linear1D">
                        Perfiles 1D
                    </button>
                    <button type="button"
                            class="btn btn-sm @(_filtroTipoMaterial == MaterialType.Sheet2D ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => _filtroTipoMaterial = MaterialType.Sheet2D">
                        Planchas 2D
                    </button>
                    <button type="button"
                            class="btn btn-sm @(_filtroTipoMaterial == MaterialType.Unit ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => _filtroTipoMaterial = MaterialType.Unit">
                        Herrajes
                    </button>
                </div>

                <button type="button" class="btn btn-success btn-sm" @onclick="AbrirNuevoMaterial">
                    @(_mostrarFormMaterial && _editandoMaterialId is null ? "Cancelar" : "+ Nuevo Material")
                </button>
            </div>

            <div class="input-group mb-3 shadow-sm">
                <input type="text" class="form-control" placeholder="Buscar material por código o nombre..."
                       @bind="_buscarMaterial" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_buscarMaterial))
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _buscarMaterial = string.Empty">
                        Limpiar
                    </button>
                }
            </div>

            @* Formulario inline de Material *@
            @if (_mostrarFormMaterial)
            {
                <div class="card border-success shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold text-success mb-3">
                            @(_editandoMaterialId.HasValue ? "Editar material" : "Nuevo material")
                        </h6>

                        <div class="row g-2 mb-2">
                            <div class="col-5 col-md-3">
                                <label class="form-label form-label-sm fw-semibold">Código *</label>
                                <input type="text" class="form-control" @bind="_matCode" maxlength="40" placeholder="Ej: PERF-P65" />
                            </div>
                            <div class="col-7 col-md-5">
                                <label class="form-label form-label-sm fw-semibold">Nombre *</label>
                                <input type="text" class="form-control" @bind="_matName" maxlength="120" placeholder="Ej: Marco P-65 Aluminio" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label form-label-sm fw-semibold">Tipo *</label>
                                <select class="form-select" @bind="_matType">
                                    <option value="@MaterialType.Linear1D">Perfil / Barra 1D</option>
                                    <option value="@MaterialType.Sheet2D">Plancha / Cristal 2D</option>
                                    <option value="@MaterialType.Unit">Herraje / Unidad</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6 col-md-3">
                                <label class="form-label form-label-sm fw-semibold">Costo Unit. (RD$) *</label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="_matUnitCost" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label form-label-sm fw-semibold">Desperdicio (%)</label>
                                <input type="number" step="0.5" min="0" max="100" class="form-control" @bind="_matWaste" />
                            </div>

                            @if (_matType == MaterialType.Linear1D)
                            {
                                <div class="col-12 col-md-6">
                                    <label class="form-label form-label-sm fw-semibold">Largo comercial barra (pulg.)</label>
                                    <input type="number" step="0.5" min="0" class="form-control"
                                           @bind="_matLengthIn" placeholder="Ej: 252 (21 pies). Vacío = por pie" />
                                </div>
                            }
                            else if (_matType == MaterialType.Sheet2D)
                            {
                                <div class="col-6 col-md-3">
                                    <label class="form-label form-label-sm fw-semibold">Ancho plancha (pulg.)</label>
                                    <input type="number" step="0.5" min="0" class="form-control"
                                           @bind="_matWidthIn" placeholder="Ej: 48" />
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label form-label-sm fw-semibold">Alto plancha (pulg.)</label>
                                    <input type="number" step="0.5" min="0" class="form-control"
                                           @bind="_matHeightIn" placeholder="Ej: 96" />
                                </div>
                            }
                        </div>

                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-12 col-md-8">
                                <label class="form-label form-label-sm fw-semibold">Colores disponibles (opcional)</label>
                                <input type="text" class="form-control" @bind="_matColors" maxlength="200"
                                       placeholder="Ej: Blanco, Bronce, Negro, Natural" />
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="chkMatActivo" @bind="_matActive" />
                                    <label class="form-check-label fw-semibold" for="chkMatActivo">
                                        Material activo
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="CerrarFormMaterial" disabled="@_guardando">
                                Cancelar
                            </button>
                            <button type="button" class="btn btn-success"
                                    @onclick="GuardarMaterialAsync" disabled="@_guardando">
                                @(_guardando ? "Guardando..." : "Guardar material")
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* Lista de materiales *@
            <div class="d-flex flex-column gap-2">
                @foreach (var mat in MaterialesFiltrados)
                {
                    <div class="p-3 rounded shadow-sm bg-white border @(mat.IsActive ? "" : "opacity-75 bg-light")">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div style="min-width: 0;">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-bold text-break">@mat.Name</span>
                                    <span class="badge bg-light text-dark border">@mat.Code</span>
                                    <span class="badge @ClaseTipoMaterial(mat.MaterialType)">@EtiquetaTipoMaterial(mat.MaterialType)</span>
                                    @if (!mat.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </div>
                                <small class="text-muted d-block mt-1">
                                    Formato: @FormatoComercial(mat) · Desperdicio: @mat.DefaultWastePercent.ToString("0.#")%
                                </small>
                            </div>

                            <div class="text-end text-nowrap">
                                <div class="fw-bold text-success">RD$ @mat.UnitCost.ToString("N2")</div>
                                <div class="d-flex gap-1 justify-content-end mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            @onclick="() => EditarMaterial(mat)">
                                        Editar
                                    </button>
                                    @if (_confirmarBorrarMaterialId == mat.Id)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger"
                                                @onclick="() => BorrarMaterialAsync(mat.Id)" disabled="@_guardando">
                                            Confirmar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => _confirmarBorrarMaterialId = null" disabled="@_guardando">
                                            No
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                @onclick="() => _confirmarBorrarMaterialId = mat.Id">
                                            Borrar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* ===================================================================== *@
        @* PESTAÑA 2: MODELOS FABRICABLES                                        *@
        @* ===================================================================== *@
        else if (_pestana == PestanaCatalogo.Modelos)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex flex-wrap gap-1">
                    <button type="button"
                            class="btn btn-sm @(_filtroCategoriaId is null ? "btn-dark" : "btn-outline-secondary")"
                            @onclick="() => _filtroCategoriaId = null">
                        Todas
                    </button>
                    @foreach (var cat in _paquete.Categories)
                    {
                        <button type="button"
                                class="btn btn-sm @(_filtroCategoriaId == cat.Id ? "btn-dark" : "btn-outline-secondary")"
                                @onclick="() => _filtroCategoriaId = cat.Id">
                            @cat.Name
                        </button>
                    }
                </div>
                <button type="button"
                        class="btn btn-sm @(_mostrarFormModelo && _editandoModeloId is null ? "btn-outline-secondary" : "btn-success")"
                        @onclick="AbrirNuevoModelo">
                    @(_mostrarFormModelo && _editandoModeloId is null ? "Cancelar" : "+ Nuevo Modelo")
                </button>
            </div>

            @* Formulario inline de Modelo *@
            @if (_mostrarFormModelo)
            {
                <div class="card border-primary shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold text-primary mb-3">
                            @(_editandoModeloId.HasValue ? "Editar modelo" : "Nuevo modelo")
                        </h6>

                        <div class="row g-2 mb-2">
                            <div class="col-12 col-md-4">
                                <label class="form-label form-label-sm fw-semibold">Categoría *</label>
                                <select class="form-select" @bind="_modCategoryId">
                                    @foreach (var cat in _paquete.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-5 col-md-3">
                                <label class="form-label form-label-sm fw-semibold">Código *</label>
                                <input type="text" class="form-control" @bind="_modCode" maxlength="40" placeholder="@EjemploModelo.Cod" />
                            </div>
                            <div class="col-7 col-md-5">
                                <label class="form-label form-label-sm fw-semibold">Nombre *</label>
                                <input type="text" class="form-control" @bind="_modName" maxlength="120" placeholder="@EjemploModelo.Nom" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-12 col-md-4">
                                <label class="form-label form-label-sm fw-semibold">Modo mano de obra</label>
                                <select class="form-select" @bind="_modLaborMode">
                                    <option value="@LaborMode.Fixed">Fijo por unidad (RD$)</option>
                                    <option value="@LaborMode.PerSqFt">Por pie² (RD$ / ft²)</option>
                                    <option value="@LaborMode.Percent">Porcentaje de materiales (%)</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm fw-semibold">Valor mano de obra</label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="_modLaborValue" />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm fw-semibold">Margen ganancia (%)</label>
                                <input type="number" step="0.5" min="0" max="300" class="form-control" @bind="_modMargin" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3 align-items-end">
                            @if (UsaTablero)
                            {
                                <div class="col-6 col-md-4">
                                    <label class="form-label form-label-sm fw-semibold">Grosor tablero (pulg. 1/16")</label>
                                    <input type="text" class="form-control" @bind="_modThicknessTexto" placeholder="Ej: 3/4 o 0" />
                                </div>
                            }
                            <div class="col-6 col-md-4">
                                <label class="form-label form-label-sm fw-semibold">Orden</label>
                                <input type="number" min="0" max="999" class="form-control" @bind="_modSortOrder" />
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check d-flex align-items-center gap-2 mb-2">
                                    <input class="form-check-input mt-0" style="width:1.1rem;height:1.1rem;flex-shrink:0;"
                                           type="checkbox" id="chkModActivo" @bind="_modActive" />
                                    <label class="form-check-label fw-semibold" for="chkModActivo">
                                        Modelo activo
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="CerrarFormModelo" disabled="@_guardando">
                                Cancelar
                            </button>
                            <button type="button" class="btn btn-primary"
                                    @onclick="GuardarModeloAsync" disabled="@_guardando">
                                @(_guardando ? "Guardando..." : "Guardar modelo")
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* Lista de modelos *@
            <div class="d-flex flex-column gap-2">
                @foreach (var mod in ModelosFiltrados)
                {
                    var catNombre = _paquete.Categories.FirstOrDefault(c => c.Id == mod.CategoryId)?.Name ?? "Categoría";

                    <div class="p-3 rounded shadow-sm bg-white border @(mod.IsActive ? "" : "opacity-75 bg-light")">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div style="min-width: 0;">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-bold text-break">@mod.Name</span>
                                    <span class="badge bg-light text-dark border">@mod.Code</span>
                                    <span class="badge bg-primary-subtle text-primary">@catNombre</span>
                                    @if (!mod.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </div>
                                <small class="text-muted d-block mt-1">
                                    Mano obra: @EtiquetaManoObra(mod) · Margen: @mod.DefaultMarginPercent.ToString("0.##")%
                                    @if (mod.DefaultBoardThicknessSixteenths > 0)
                                    {
                                        <span> · Tablero: @(new MeasureFraction(mod.DefaultBoardThicknessSixteenths))</span>
                                    }
                                </small>
                                <small class="text-muted d-block">
                                    @mod.CutRules.Count reglas de corte · @mod.HardwareRules.Count reglas de herrajes
                                </small>
                            </div>

                            <div class="d-flex flex-wrap gap-1 justify-content-end text-nowrap">
                                <button type="button"
                                        class="btn btn-sm @(_modeloReglasId == mod.Id ? "btn-dark" : "btn-outline-dark")"
                                        @onclick="() => ToggleReglasModelo(mod.Id)">
                                    @(_modeloReglasId == mod.Id ? "Ocultar reglas" : "Reglas")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => DuplicarModeloAsync(mod)"
                                        disabled="@_guardando">
                                    Duplicar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        @onclick="() => EditarModelo(mod)">
                                    Editar
                                </button>
                                @if (_confirmarBorrarModeloId == mod.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-danger"
                                            @onclick="() => BorrarModeloAsync(mod.Id)" disabled="@_guardando">
                                        Confirmar
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => _confirmarBorrarModeloId = null" disabled="@_guardando">
                                        No
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => _confirmarBorrarModeloId = mod.Id">
                                        Borrar
                                    </button>
                                }
                            </div>
                        </div>

                        @* ============================================================= *@
                        @* PANEL DESPLEGABLE DE REGLAS DE CORTE Y HERRAJES               *@
                        @* ============================================================= *@
                        @if (_modeloReglasId == mod.Id)
                        {
                            <div class="mt-3 pt-3 border-top">
                                @* --- REGLAS DE CORTE --- *@
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 fw-bold text-dark">Reglas de Corte (@mod.CutRules.Count)</h6>
                                    <button type="button" class="btn btn-sm btn-outline-success"
                                            @onclick="() => AbrirNuevaReglaCorte(mod)">
                                        @(_mostrarFormCorte && _editandoCorteId is null ? "Cancelar" : "+ Agregar pieza")
                                    </button>
                                </div>

                                @if (_mostrarFormCorte)
                                {
                                    <div class="p-3 rounded bg-light border mb-3">
                                        <div class="fw-semibold small text-success mb-2">
                                            @(_editandoCorteId.HasValue ? "Editar regla de corte" : "Nueva regla de corte")
                                        </div>

                                        <div class="row g-2 mb-2">
                                            <div class="col-12 col-md-4">
                                                <label class="form-label form-label-sm fw-semibold">Nombre pieza *</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       @bind="_cortePartName" placeholder="Ej: Cristal 1/4&quot;, Cabezal" maxlength="100" />
                                            </div>
                                            <div class="col-12 col-md-5">
                                                <label class="form-label form-label-sm fw-semibold">Material *</label>
                                                <select class="form-select form-select-sm" @bind="_corteMaterialId">
                                                    @foreach (var m in _paquete.Materials)
                                                    {
                                                        <option value="@m.Id">@m.Name (@m.Code)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-3">
                                                <label class="form-label form-label-sm fw-semibold">Tipo medida</label>
                                                <select class="form-select form-select-sm" @bind="_corteMeasureMode">
                                                    @foreach (var modo in Enum.GetValues<MeasureMode>())
                                                    {
                                                        <option value="@modo">@EtiquetaModoMedida(modo)</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row g-2 mb-2">
                                            <div class="col-4">
                                                <label class="form-label form-label-sm fw-semibold">Medida 1 (Eje)</label>
                                                <select class="form-select form-select-sm" @bind="_corteDim1Axis">
                                                    @foreach (var eje in Enum.GetValues<DimensionAxis>())
                                                    {
                                                        <option value="@eje">@EtiquetaEje(eje)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label form-label-sm fw-semibold">Dividir entre</label>
                                                <select class="form-select form-select-sm" @bind="_corteDim1Div">
                                                    @foreach (var div in Enum.GetValues<DivisorSource>())
                                                    {
                                                        <option value="@div">@EtiquetaDivisor(div)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label form-label-sm fw-semibold">Ajuste (1/16")</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       @bind="_corteDim1OffsetTexto" placeholder="Ej: -1 1/2 o 0" />
                                            </div>
                                        </div>

                                        @if (_corteMeasureMode != MeasureMode.Length1D)
                                        {
                                            <div class="row g-2 mb-2">
                                                <div class="col-4">
                                                    <label class="form-label form-label-sm fw-semibold">Medida 2 (Eje)</label>
                                                    <select class="form-select form-select-sm" @bind="_corteDim2Axis">
                                                        @foreach (var eje in Enum.GetValues<DimensionAxis>())
                                                        {
                                                            <option value="@eje">@EtiquetaEje(eje)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-4">
                                                    <label class="form-label form-label-sm fw-semibold">Dividir entre</label>
                                                    <select class="form-select form-select-sm" @bind="_corteDim2Div">
                                                        @foreach (var div in Enum.GetValues<DivisorSource>())
                                                        {
                                                            <option value="@div">@EtiquetaDivisor(div)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-4">
                                                    <label class="form-label form-label-sm fw-semibold">Ajuste (1/16")</label>
                                                    <input type="text" class="form-control form-control-sm"
                                                           @bind="_corteDim2OffsetTexto" placeholder="Ej: -2 1/2 o 0" />
                                                </div>
                                            </div>
                                        }

                                        <div class="row g-2 mb-3">
                                            <div class="col-6 col-md-4">
                                                <label class="form-label form-label-sm fw-semibold">Cantidad según</label>
                                                <select class="form-select form-select-sm" @bind="_corteQtyMode">
                                                    @foreach (var qm in Enum.GetValues<QuantityMode>())
                                                    {
                                                        <option value="@qm">@EtiquetaModoCantidad(qm)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label form-label-sm fw-semibold">Factor cant.</label>
                                                <input type="number" min="1" max="100" class="form-control form-control-sm"
                                                       @bind="_corteQtyFactor" />
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="CerrarFormCorte" disabled="@_guardando">
                                                Cancelar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    @onclick="() => GuardarReglaCorteAsync(mod.Id)" disabled="@_guardando">
                                                @(_guardando ? "Guardando..." : "Guardar pieza")
                                            </button>
                                        </div>
                                    </div>
                                }

                                @if (mod.CutRules.Count == 0)
                                {
                                    <p class="small text-muted mb-3">Sin reglas de corte configuradas.</p>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush border rounded mb-3">
                                        @foreach (var r in mod.CutRules)
                                        {
                                            <div class="list-group-item py-2 px-3 d-flex justify-content-between align-items-center gap-2">
                                                <div style="min-width: 0;">
                                                    <div class="fw-semibold small">@r.PartName</div>
                                                    <div class="small text-muted">
                                                        @NombreMaterial(r.MaterialId) · @ResumenReglaCorte(r)
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-1 text-nowrap">
                                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                                            @onclick="() => EditarReglaCorte(r)">
                                                        Editar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                                            @onclick="() => BorrarReglaCorteAsync(r.Id)" disabled="@_guardando">
                                                        X
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* --- REGLAS DE HERRAJES --- *@
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 fw-bold text-dark">Herrajes y Consumibles (@mod.HardwareRules.Count)</h6>
                                    <button type="button" class="btn btn-sm btn-outline-success"
                                            @onclick="() => AbrirNuevaReglaHerraje(mod)">
                                        @(_mostrarFormHerraje && _editandoHerrajeId is null ? "Cancelar" : "+ Agregar herraje")
                                    </button>
                                </div>

                                @if (_mostrarFormHerraje)
                                {
                                    <div class="p-3 rounded bg-light border mb-3">
                                        <div class="fw-semibold small text-success mb-2">
                                            @(_editandoHerrajeId.HasValue ? "Editar herraje" : "Nuevo herraje / consumible")
                                        </div>

                                        <div class="row g-2 mb-3">
                                            <div class="col-12 col-md-5">
                                                <label class="form-label form-label-sm fw-semibold">Material / Herraje *</label>
                                                <select class="form-select form-select-sm" @bind="_herrMaterialId">
                                                    @foreach (var m in _paquete.Materials)
                                                    {
                                                        <option value="@m.Id">@m.Name (@m.Code)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-7 col-md-4">
                                                <label class="form-label form-label-sm fw-semibold">Se calcula</label>
                                                <select class="form-select form-select-sm" @bind="_herrBasis">
                                                    @foreach (var b in Enum.GetValues<HardwareCalculationBasis>())
                                                    {
                                                        <option value="@b">@EtiquetaBaseHerraje(b)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-5 col-md-3">
                                                <label class="form-label form-label-sm fw-semibold">Cantidad *</label>
                                                <input type="number" step="0.01" min="0.01" class="form-control form-control-sm"
                                                       @bind="_herrFactor" />
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="CerrarFormHerraje" disabled="@_guardando">
                                                Cancelar
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    @onclick="() => GuardarReglaHerrajeAsync(mod.Id)" disabled="@_guardando">
                                                @(_guardando ? "Guardando..." : "Guardar herraje")
                                            </button>
                                        </div>
                                    </div>
                                }

                                @if (mod.HardwareRules.Count == 0)
                                {
                                    <p class="small text-muted mb-0">Sin herrajes configurados.</p>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush border rounded">
                                        @foreach (var h in mod.HardwareRules)
                                        {
                                            <div class="list-group-item py-2 px-3 d-flex justify-content-between align-items-center gap-2">
                                                <div style="min-width: 0;">
                                                    <div class="fw-semibold small">@NombreMaterial(h.MaterialId)</div>
                                                    <div class="small text-muted">
                                                        @h.Factor.ToString("0.##") × @EtiquetaBaseHerraje(h.CalculationBasis)
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-1 text-nowrap">
                                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                                            @onclick="() => EditarReglaHerraje(h)">
                                                        Editar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                                            @onclick="() => BorrarReglaHerrajeAsync(h.Id)" disabled="@_guardando">
                                                        X
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private enum PestanaCatalogo { Materiales, Modelos }
    private PestanaCatalogo _pestana = PestanaCatalogo.Materiales;

    private CatalogoUniversalPaqueteDto? _paquete;
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private string? _mensajeOk;

    // Filtros
    private MaterialType? _filtroTipoMaterial;
    private string _buscarMaterial = "";
    private Guid? _filtroCategoriaId;

    // Formulario Material
    private bool _mostrarFormMaterial;
    private Guid? _editandoMaterialId;
    private Guid? _confirmarBorrarMaterialId;
    private string _matCode = "";
    private string _matName = "";
    private MaterialType _matType = MaterialType.Linear1D;
    private decimal _matUnitCost;
    private decimal _matWaste = 10m;
    private decimal? _matLengthIn;
    private decimal? _matWidthIn;
    private decimal? _matHeightIn;
    private string _matColors = "";
    private bool _matActive = true;

    // Formulario Modelo
    private bool _mostrarFormModelo;
    private Guid? _editandoModeloId;
    private Guid? _confirmarBorrarModeloId;
    private Guid _modCategoryId;
    private string _modCode = "";
    private string _modName = "";
    private LaborMode _modLaborMode = LaborMode.PerSqFt;
    private decimal _modLaborValue;
    private decimal _modMargin = 35m;
    private string _modThicknessTexto = "0";
    private int _modSortOrder;
    private bool _modActive = true;

    // Panel visual de Reglas (Corte y Herrajes)
    private Guid? _modeloReglasId;

    private bool _mostrarFormCorte;
    private Guid? _editandoCorteId;
    private string _cortePartName = "";
    private Guid _corteMaterialId;
    private MeasureMode _corteMeasureMode = MeasureMode.Length1D;
    private DimensionAxis _corteDim1Axis = DimensionAxis.Width;
    private DivisorSource _corteDim1Div = DivisorSource.ConstantOne;
    private string _corteDim1OffsetTexto = "0";
    private decimal _corteDim1CustomDiv = 1m;
    private int _corteDim1ThickMult;
    private DimensionAxis _corteDim2Axis = DimensionAxis.Height;
    private DivisorSource _corteDim2Div = DivisorSource.ConstantOne;
    private string _corteDim2OffsetTexto = "0";
    private decimal _corteDim2CustomDiv = 1m;
    private int _corteDim2ThickMult;
    private QuantityMode _corteQtyMode = QuantityMode.Fixed;
    private int _corteQtyFactor = 1;
    private RuleCondition? _corteCondition;
    private int _corteSortOrder = 1;

    private bool _mostrarFormHerraje;
    private Guid? _editandoHerrajeId;
    private Guid _herrMaterialId;
    private HardwareCalculationBasis _herrBasis = HardwareCalculationBasis.PerUnit;
    private decimal _herrFactor = 1m;
    private RuleCondition? _herrCondition;
    private int _herrSortOrder = 1;

    private IEnumerable<MaterialCatalogDto> MaterialesFiltrados
    {
        get
        {
            if (_paquete is null) return [];
            var lista = _paquete.Materials.AsEnumerable();

            if (_filtroTipoMaterial.HasValue)
                lista = lista.Where(m => m.MaterialType == _filtroTipoMaterial.Value);

            if (!string.IsNullOrWhiteSpace(_buscarMaterial))
            {
                var q = _buscarMaterial.Trim();
                lista = lista.Where(m =>
                    m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.Code.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return lista;
        }
    }

    private IEnumerable<ProductModelDto> ModelosFiltrados =>
        _paquete is null
            ? []
            : _filtroCategoriaId.HasValue
                ? _paquete.Models.Where(m => m.CategoryId == _filtroCategoriaId.Value)
                : _paquete.Models;
    private string CategoriaSeleccionada =>
_paquete?.Categories.FirstOrDefault(c => c.Id == _modCategoryId)?.Name ?? "";

    private bool UsaTablero =>
        !CategoriaSeleccionada.Contains("Ventana", StringComparison.OrdinalIgnoreCase);

    private (string Cod, string Nom) EjemploModelo => CategoriaSeleccionada switch
    {
        var s when s.Contains("Puerta", StringComparison.OrdinalIgnoreCase) => ("Ej: PTA-P65", "Ej: Puerta Corrediza P-65"),
        var s when s.Contains("Gabinete", StringComparison.OrdinalIgnoreCase) => ("Ej: GAB-BAJO", "Ej: Gabinete Bajo Melamina"),
        var s when s.Contains("Closet", StringComparison.OrdinalIgnoreCase) => ("Ej: CLOSET-MOD", "Ej: Closet Modular Melamina"),
        _ => ("Ej: VENT-P65", "Ej: Ventana Corrediza P-65")
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogoAsync(forzar: false);
    }

    private async Task CargarCatalogoAsync(bool forzar)
    {
        _cargando = true;
        _error = null;

        _paquete = await ServicioCatalogo.ObtenerPaqueteAsync(
            incluirInactivos: true,
            forzarRecarga: forzar);

        if (_paquete is null)
            _error = ServicioCatalogo.UltimoError ?? "No se pudo cargar el catálogo.";

        _cargando = false;
    }

    // =========================================================================
    // CRUD MATERIALES
    // =========================================================================

    private void AbrirNuevoMaterial()
    {
        if (_mostrarFormMaterial && _editandoMaterialId is null)
        {
            _mostrarFormMaterial = false;
            return;
        }

        _editandoMaterialId = null;
        _error = null;
        _mensajeOk = null;

        _matCode = "";
        _matName = "";
        _matType = _filtroTipoMaterial ?? MaterialType.Linear1D;
        _matUnitCost = 0m;
        _matWaste = 10m;
        _matLengthIn = _matType == MaterialType.Linear1D ? 252m : null;
        _matWidthIn = _matType == MaterialType.Sheet2D ? 48m : null;
        _matHeightIn = _matType == MaterialType.Sheet2D ? 96m : null;
        _matColors = "";
        _matActive = true;

        _mostrarFormMaterial = true;
    }

    private void EditarMaterial(MaterialCatalogDto mat)
    {
        _editandoMaterialId = mat.Id;
        _error = null;
        _mensajeOk = null;

        _matCode = mat.Code;
        _matName = mat.Name;
        _matType = mat.MaterialType;
        _matUnitCost = mat.UnitCost;
        _matWaste = mat.DefaultWastePercent;
        _matLengthIn = mat.CommercialLengthInches;
        _matWidthIn = mat.CommercialWidthInches;
        _matHeightIn = mat.CommercialHeightInches;
        _matColors = mat.ColorOptions ?? "";
        _matActive = mat.IsActive;

        _mostrarFormMaterial = true;
    }

    private void CerrarFormMaterial()
    {
        _mostrarFormMaterial = false;
        _editandoMaterialId = null;
    }

    private async Task GuardarMaterialAsync()
    {
        _error = null;
        _mensajeOk = null;

        if (string.IsNullOrWhiteSpace(_matCode) || string.IsNullOrWhiteSpace(_matName))
        {
            _error = "Código y nombre del material son obligatorios.";
            return;
        }

        var dto = new GuardarMaterialCatalogDto(
            Code: _matCode.Trim(),
            Name: _matName.Trim(),
            MaterialType: _matType,
            CommercialLengthInches: _matType == MaterialType.Linear1D ? _matLengthIn : null,
            CommercialWidthInches: _matType == MaterialType.Sheet2D ? _matWidthIn : null,
            CommercialHeightInches: _matType == MaterialType.Sheet2D ? _matHeightIn : null,
            UnitCost: Math.Max(0m, _matUnitCost),
            DefaultWastePercent: Math.Max(0m, _matWaste),
            ColorOptions: string.IsNullOrWhiteSpace(_matColors) ? null : _matColors.Trim(),
            IsActive: _matActive);

        _guardando = true;
        string? error;

        if (_editandoMaterialId.HasValue)
        {
            (_, error) = await ServicioCatalogo.EditarMaterialAsync(_editandoMaterialId.Value, dto);
        }
        else
        {
            (_, error) = await ServicioCatalogo.CrearMaterialAsync(dto);
        }

        _guardando = false;

        if (error is not null)
        {
            _error = error;
            return;
        }

        CerrarFormMaterial();
        _mensajeOk = "Material guardado correctamente.";
        await CargarCatalogoAsync(forzar: true);
    }

    private async Task BorrarMaterialAsync(Guid id)
    {
        _guardando = true;
        _error = null;
        _mensajeOk = null;

        var (exito, error) = await ServicioCatalogo.BorrarMaterialAsync(id);
        _guardando = false;
        _confirmarBorrarMaterialId = null;

        if (!exito)
        {
            _error = error ?? "No se pudo eliminar el material.";
            return;
        }

        _mensajeOk = "Material eliminado.";
        await CargarCatalogoAsync(forzar: true);
    }

    // =========================================================================
    // CRUD MODELOS
    // =========================================================================

    private void AbrirNuevoModelo()
    {
        if (_mostrarFormModelo && _editandoModeloId is null)
        {
            _mostrarFormModelo = false;
            return;
        }

        _editandoModeloId = null;
        _error = null;
        _mensajeOk = null;

        _modCategoryId = _filtroCategoriaId ?? _paquete?.Categories.FirstOrDefault()?.Id ?? Guid.Empty;
        _modCode = "";
        _modName = "";
        _modLaborMode = LaborMode.PerSqFt;
        _modLaborValue = 0m;
        _modMargin = 35m;
        _modThicknessTexto = "0";
        _modSortOrder = (_paquete?.Models.Count ?? 0) + 1;
        _modActive = true;

        _mostrarFormModelo = true;
    }

    private void EditarModelo(ProductModelDto mod)
    {
        _editandoModeloId = mod.Id;
        _error = null;
        _mensajeOk = null;

        _modCategoryId = mod.CategoryId;
        _modCode = mod.Code;
        _modName = mod.Name;
        _modLaborMode = mod.DefaultLaborMode;
        _modLaborValue = mod.DefaultLaborValue;
        _modMargin = mod.DefaultMarginPercent;
        _modThicknessTexto = mod.DefaultBoardThicknessSixteenths > 0
            ? new MeasureFraction(mod.DefaultBoardThicknessSixteenths).ToString().Replace("\"", "")
            : "0";
        _modSortOrder = mod.SortOrder;
        _modActive = mod.IsActive;

        _mostrarFormModelo = true;
    }

    private void CerrarFormModelo()
    {
        _mostrarFormModelo = false;
        _editandoModeloId = null;
    }

    private async Task GuardarModeloAsync()
    {
        _error = null;
        _mensajeOk = null;

        if (_modCategoryId == Guid.Empty)
        {
            _error = "Selecciona una categoría.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_modCode) || string.IsNullOrWhiteSpace(_modName))
        {
            _error = "Código y nombre del modelo son obligatorios.";
            return;
        }

        int grosorSixteenths = 0;
        if (UsaTablero && !string.IsNullOrWhiteSpace(_modThicknessTexto))
        {
            if (!MeasureFraction.TryParse(_modThicknessTexto, out var grosor) || grosor.Sixteenths < 0)
            {
                _error = "Grosor de tablero inválido (usa por ejemplo: 3/4, 5/8 o 0).";
                return;
            }
            grosorSixteenths = grosor.Sixteenths;
        }

        var dto = new GuardarProductModelDto(
            CategoryId: _modCategoryId,
            Code: _modCode.Trim(),
            Name: _modName.Trim(),
            DefaultBoardThicknessSixteenths: grosorSixteenths,
            DefaultLaborMode: _modLaborMode,
            DefaultLaborValue: Math.Max(0m, _modLaborValue),
            DefaultMarginPercent: Math.Max(0m, _modMargin),
            SortOrder: _modSortOrder,
            IsActive: _modActive);

        _guardando = true;
        string? error;

        if (_editandoModeloId.HasValue)
        {
            (_, error) = await ServicioCatalogo.EditarModeloAsync(_editandoModeloId.Value, dto);
        }
        else
        {
            (_, error) = await ServicioCatalogo.CrearModeloAsync(dto);
        }

        _guardando = false;

        if (error is not null)
        {
            _error = error;
            return;
        }

        CerrarFormModelo();
        _mensajeOk = "Modelo guardado correctamente.";
        await CargarCatalogoAsync(forzar: true);
    }

    private async Task BorrarModeloAsync(Guid id)
    {
        _guardando = true;
        _error = null;
        _mensajeOk = null;

        var (exito, error) = await ServicioCatalogo.BorrarModeloAsync(id);
        _guardando = false;
        _confirmarBorrarModeloId = null;

        if (!exito)
        {
            _error = error ?? "No se pudo eliminar el modelo.";
            return;
        }

        if (_modeloReglasId == id) _modeloReglasId = null;
        _mensajeOk = "Modelo eliminado.";
        await CargarCatalogoAsync(forzar: true);
    }

    private async Task DuplicarModeloAsync(ProductModelDto mod)
    {
        _guardando = true;
        _error = null;
        _mensajeOk = null;

        var (exito, error) = await ServicioCatalogo.DuplicarModeloAsync(mod.Id);
        _guardando = false;

        if (!exito)
        {
            _error = error ?? "No se pudo duplicar el modelo.";
            return;
        }

        _mensajeOk = $"Modelo '{mod.Name}' duplicado con todas sus reglas.";
        await CargarCatalogoAsync(forzar: true);
    }

    // =========================================================================
    // CRUD REGLAS DE CORTE Y HERRAJES
    // =========================================================================

    private void ToggleReglasModelo(Guid modeloId)
    {
        if (_modeloReglasId == modeloId)
        {
            _modeloReglasId = null;
            CerrarFormCorte();
            CerrarFormHerraje();
            return;
        }

        _modeloReglasId = modeloId;
        CerrarFormCorte();
        CerrarFormHerraje();
    }

    private void AbrirNuevaReglaCorte(ProductModelDto mod)
    {
        if (_mostrarFormCorte && _editandoCorteId is null)
        {
            CerrarFormCorte();
            return;
        }

        _editandoCorteId = null;
        _error = null;
        _mensajeOk = null;

        _cortePartName = "";
        _corteMaterialId = _paquete?.Materials.FirstOrDefault()?.Id ?? Guid.Empty;
        _corteMeasureMode = MeasureMode.Length1D;
        _corteDim1Axis = DimensionAxis.Width;
        _corteDim1Div = DivisorSource.ConstantOne;
        _corteDim1OffsetTexto = "0";
        _corteDim1CustomDiv = 1m;
        _corteDim1ThickMult = 0;
        _corteDim2Axis = DimensionAxis.Height;
        _corteDim2Div = DivisorSource.ConstantOne;
        _corteDim2OffsetTexto = "0";
        _corteDim2CustomDiv = 1m;
        _corteDim2ThickMult = 0;
        _corteQtyMode = QuantityMode.Fixed;
        _corteQtyFactor = 1;
        _corteCondition = null;
        _corteSortOrder = mod.CutRules.Count + 1;

        _mostrarFormCorte = true;
    }

    private void EditarReglaCorte(CutRuleDto r)
    {
        _editandoCorteId = r.Id;
        _error = null;
        _mensajeOk = null;

        _cortePartName = r.PartName;
        _corteMaterialId = r.MaterialId;
        _corteMeasureMode = r.MeasureMode;
        _corteDim1Axis = r.Dim1Axis;
        _corteDim1Div = r.Dim1DivisorSource;
        _corteDim1OffsetTexto = FormatearAjusteConSigno(r.Dim1OffsetSixteenths);
        _corteDim1CustomDiv = r.Dim1CustomDivisor;
        _corteDim1ThickMult = r.Dim1ThicknessMultiplier;
        _corteDim2Axis = r.Dim2Axis;
        _corteDim2Div = r.Dim2DivisorSource;
        _corteDim2OffsetTexto = FormatearAjusteConSigno(r.Dim2OffsetSixteenths);
        _corteDim2CustomDiv = r.Dim2CustomDivisor;
        _corteDim2ThickMult = r.Dim2ThicknessMultiplier;
        _corteQtyMode = r.QuantityMode;
        _corteQtyFactor = r.QuantityFactor;
        _corteCondition = r.Condition;
        _corteSortOrder = r.SortOrder;

        _mostrarFormCorte = true;
    }

    private void CerrarFormCorte()
    {
        _mostrarFormCorte = false;
        _editandoCorteId = null;
    }

    private async Task GuardarReglaCorteAsync(Guid modeloId)
    {
        _error = null;
        _mensajeOk = null;

        if (string.IsNullOrWhiteSpace(_cortePartName))
        {
            _error = "Escribe el nombre de la pieza (ej: Cristal 1/4\" o Cabezal).";
            return;
        }
        if (_corteMaterialId == Guid.Empty)
        {
            _error = "Selecciona un material para la pieza.";
            return;
        }
        if (!IntentarParsearAjusteConSigno(_corteDim1OffsetTexto, out var offset1))
        {
            _error = "Ajuste de Medida 1 inválido (ej: -1 1/2, 3/4 o 0).";
            return;
        }

        int offset2 = 0;
        if (_corteMeasureMode != MeasureMode.Length1D &&
            !IntentarParsearAjusteConSigno(_corteDim2OffsetTexto, out offset2))
        {
            _error = "Ajuste de Medida 2 inválido (ej: -2 1/2, 1/4 o 0).";
            return;
        }

        var dto = new GuardarCutRuleDto(
            PartName: _cortePartName.Trim(),
            MaterialId: _corteMaterialId,
            MeasureMode: _corteMeasureMode,
            Dim1Axis: _corteDim1Axis,
            Dim1DivisorSource: _corteDim1Div,
            Dim1CustomDivisor: _corteDim1CustomDiv <= 0 ? 1m : _corteDim1CustomDiv,
            Dim1OffsetSixteenths: offset1,
            Dim1ThicknessMultiplier: _corteDim1ThickMult,
            Dim2Axis: _corteMeasureMode == MeasureMode.Length1D ? DimensionAxis.None : _corteDim2Axis,
            Dim2DivisorSource: _corteMeasureMode == MeasureMode.Length1D ? DivisorSource.ConstantOne : _corteDim2Div,
            Dim2CustomDivisor: _corteDim2CustomDiv <= 0 ? 1m : _corteDim2CustomDiv,
            Dim2OffsetSixteenths: _corteMeasureMode == MeasureMode.Length1D ? 0 : offset2,
            Dim2ThicknessMultiplier: _corteMeasureMode == MeasureMode.Length1D ? 0 : _corteDim2ThickMult,
            QuantityMode: _corteQtyMode,
            QuantityFactor: Math.Max(1, _corteQtyFactor),
            Condition: _corteCondition,
            SortOrder: _corteSortOrder);

        _guardando = true;
        string? error;

        if (_editandoCorteId.HasValue)
        {
            (_, error) = await ServicioCatalogo.EditarReglaCorteAsync(_editandoCorteId.Value, dto);
        }
        else
        {
            (_, error) = await ServicioCatalogo.CrearReglaCorteAsync(modeloId, dto);
        }

        _guardando = false;

        if (error is not null)
        {
            _error = error;
            return;
        }

        CerrarFormCorte();
        _mensajeOk = "Regla de corte guardada.";
        await CargarCatalogoAsync(forzar: true);
    }

    private async Task BorrarReglaCorteAsync(Guid reglaId)
    {
        _guardando = true;
        _error = null;
        _mensajeOk = null;

        var (exito, error) = await ServicioCatalogo.BorrarReglaCorteAsync(reglaId);
        _guardando = false;

        if (!exito)
        {
            _error = error ?? "No se pudo eliminar la regla de corte.";
            return;
        }

        _mensajeOk = "Regla de corte eliminada.";
        await CargarCatalogoAsync(forzar: true);
    }

    private void AbrirNuevaReglaHerraje(ProductModelDto mod)
    {
        if (_mostrarFormHerraje && _editandoHerrajeId is null)
        {
            CerrarFormHerraje();
            return;
        }

        _editandoHerrajeId = null;
        _error = null;
        _mensajeOk = null;

        _herrMaterialId = _paquete?.Materials.FirstOrDefault(m => m.MaterialType == MaterialType.Unit)?.Id
            ?? _paquete?.Materials.FirstOrDefault()?.Id
            ?? Guid.Empty;
        _herrBasis = HardwareCalculationBasis.PerUnit;
        _herrFactor = 1m;
        _herrCondition = null;
        _herrSortOrder = mod.HardwareRules.Count + 1;

        _mostrarFormHerraje = true;
    }

    private void EditarReglaHerraje(HardwareRuleDto h)
    {
        _editandoHerrajeId = h.Id;
        _error = null;
        _mensajeOk = null;

        _herrMaterialId = h.MaterialId;
        _herrBasis = h.CalculationBasis;
        _herrFactor = h.Factor;
        _herrCondition = h.Condition;
        _herrSortOrder = h.SortOrder;

        _mostrarFormHerraje = true;
    }

    private void CerrarFormHerraje()
    {
        _mostrarFormHerraje = false;
        _editandoHerrajeId = null;
    }

    private async Task GuardarReglaHerrajeAsync(Guid modeloId)
    {
        _error = null;
        _mensajeOk = null;

        if (_herrMaterialId == Guid.Empty)
        {
            _error = "Selecciona un herraje o material.";
            return;
        }
        if (_herrFactor <= 0)
        {
            _error = "La cantidad debe ser mayor que cero.";
            return;
        }

        var dto = new GuardarHardwareRuleDto(
            MaterialId: _herrMaterialId,
            CalculationBasis: _herrBasis,
            Factor: _herrFactor,
            Condition: _herrCondition,
            SortOrder: _herrSortOrder);

        _guardando = true;
        string? error;

        if (_editandoHerrajeId.HasValue)
        {
            (_, error) = await ServicioCatalogo.EditarReglaHerrajeAsync(_editandoHerrajeId.Value, dto);
        }
        else
        {
            (_, error) = await ServicioCatalogo.CrearReglaHerrajeAsync(modeloId, dto);
        }

        _guardando = false;

        if (error is not null)
        {
            _error = error;
            return;
        }

        CerrarFormHerraje();
        _mensajeOk = "Regla de herraje guardada.";
        await CargarCatalogoAsync(forzar: true);
    }

    private async Task BorrarReglaHerrajeAsync(Guid reglaId)
    {
        _guardando = true;
        _error = null;
        _mensajeOk = null;

        var (exito, error) = await ServicioCatalogo.BorrarReglaHerrajeAsync(reglaId);
        _guardando = false;

        if (!exito)
        {
            _error = error ?? "No se pudo eliminar la regla de herraje.";
            return;
        }

        _mensajeOk = "Regla de herraje eliminada.";
        await CargarCatalogoAsync(forzar: true);
    }

