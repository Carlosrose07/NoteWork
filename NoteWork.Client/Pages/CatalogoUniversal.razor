    private string NombreMaterial(Guid materialId) =>
        _paquete?.Materials.FirstOrDefault(m => m.Id == materialId)?.Name ?? "Material";

    private static string FormatearAjusteConSigno(int sixteenths)
    {
        if (sixteenths == 0) return "0";
        var signo = sixteenths < 0 ? "-" : "";
        var texto = new MeasureFraction(Math.Abs(sixteenths)).ToString().Replace("\"", "");
        return $"{signo}{texto}";
    }

    private static bool IntentarParsearAjusteConSigno(string? texto, out int sixteenths)
    {
        sixteenths = 0;
        if (string.IsNullOrWhiteSpace(texto)) return true;

        var limpio = texto.Trim();
        var negativo = limpio.StartsWith('-');
        if (negativo || limpio.StartsWith('+'))
            limpio = limpio[1..].Trim();

        if (!MeasureFraction.TryParse(limpio, out var frac))
            return false;

        sixteenths = negativo ? -frac.Sixteenths : frac.Sixteenths;
        return true;
    }

    private static string ResumenReglaCorte(CutRuleDto r)
    {
        var d1 = $"{EtiquetaEje(r.Dim1Axis)}";
        if (r.Dim1DivisorSource != DivisorSource.ConstantOne) d1 += $" ÷ {EtiquetaDivisor(r.Dim1DivisorSource)}";
        if (r.Dim1OffsetSixteenths != 0) d1 += $" ({FormatearAjusteConSigno(r.Dim1OffsetSixteenths)}\")";

        if (r.MeasureMode == MeasureMode.Length1D)
            return $"{d1} · Cant: {r.QuantityFactor} ({EtiquetaModoCantidad(r.QuantityMode)})";

        var d2 = $"{EtiquetaEje(r.Dim2Axis)}";
        if (r.Dim2DivisorSource != DivisorSource.ConstantOne) d2 += $" ÷ {EtiquetaDivisor(r.Dim2DivisorSource)}";
        if (r.Dim2OffsetSixteenths != 0) d2 += $" ({FormatearAjusteConSigno(r.Dim2OffsetSixteenths)}\")";

        return $"{d1} × {d2} · Cant: {r.QuantityFactor} ({EtiquetaModoCantidad(r.QuantityMode)})";
    }

    private static string EtiquetaModoMedida(MeasureMode m) => m switch
    {
        MeasureMode.Length1D => "Lineal 1D (Perfil/Barra)",
        MeasureMode.Rect2D => "Superficie 2D (Cristal/Plancha)",
        MeasureMode.Perimeter1D => "Perímetro 1D (Tapacanto/Goma)",
        _ => m.ToString()
    };

    private static string EtiquetaEje(DimensionAxis a) => a switch
    {
        DimensionAxis.Width => "Ancho",
        DimensionAxis.Height => "Alto",
        DimensionAxis.Depth => "Profundidad",
        DimensionAxis.None => "Fijo (sin eje)",
        _ => a.ToString()
    };

    private static string EtiquetaDivisor(DivisorSource d) => d switch
    {
        DivisorSource.ConstantOne => "1 (completo)",
        DivisorSource.LeafCount => "Hojas",
        DivisorSource.DoorCount => "Puertas",
        _ => d.ToString()
    };

    private static string EtiquetaModoCantidad(QuantityMode q) => q switch
    {
        QuantityMode.Fixed => "Fijo por unidad",
        QuantityMode.PerLeaf => "Por cada hoja",
        QuantityMode.PerDoor => "Por cada puerta",
        QuantityMode.PerShelf => "Por cada repisa",
        _ => q.ToString()
    };

    private static string EtiquetaBaseHerraje(HardwareCalculationBasis b) => b switch
    {
        HardwareCalculationBasis.PerUnit => "Por unidad",
        HardwareCalculationBasis.PerLeaf => "Por hoja",
        HardwareCalculationBasis.PerDoor => "Por puerta",
        HardwareCalculationBasis.PerDrawer => "Por gaveta",
        HardwareCalculationBasis.PerimeterFeet => "Por pie de perímetro",
        _ => b.ToString()
    };

    private static string EtiquetaTipoMaterial(MaterialType tipo) => tipo switch
    {
        MaterialType.Linear1D => "Perfil 1D",
        MaterialType.Sheet2D => "Plancha 2D",
        MaterialType.Unit => "Herraje",
        _ => tipo.ToString()
    };

    private static string ClaseTipoMaterial(MaterialType tipo) => tipo switch
    {
        MaterialType.Linear1D => "bg-info-subtle text-info-emphasis",
        MaterialType.Sheet2D => "bg-warning-subtle text-warning-emphasis",
        MaterialType.Unit => "bg-secondary-subtle text-secondary-emphasis",
        _ => "bg-light text-dark"
    };

    private static string FormatoComercial(MaterialCatalogDto m) => m.MaterialType switch
    {
        MaterialType.Linear1D => m.CommercialLengthInches is > 0
            ? $"Barra {m.CommercialLengthInches.Value:0.##}\" ({m.CommercialLengthInches.Value / 12m:0.##} pies)"
            : "Por pie lineal",
        MaterialType.Sheet2D => m.CommercialWidthInches is > 0 && m.CommercialHeightInches is > 0
            ? $"Plancha {m.CommercialWidthInches.Value:0.##}\" × {m.CommercialHeightInches.Value:0.##}\""
            : "Por pie²",
        _ => "Por unidad"
    };

    private static string EtiquetaManoObra(ProductModelDto mod) => mod.DefaultLaborMode switch
    {
        LaborMode.Fixed => $"RD$ {mod.DefaultLaborValue:N2} / und",
        LaborMode.PerSqFt => $"RD$ {mod.DefaultLaborValue:N2} / pie²",
        LaborMode.Percent => $"{mod.DefaultLaborValue:0.##}% materiales",
        _ => "-"
    };
