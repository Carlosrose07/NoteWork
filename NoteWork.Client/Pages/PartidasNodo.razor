@page "/nodos/{NodoId:guid}/partidas"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using NoteWork.Shared.Entidades
@using NoteWork.Client.Servicios
@inject ServicioPartidas ServicioPartidas
@inject ServicioNodos ServicioNodos
@inject NavigationManager Navegacion

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="mb-0">
                Partidas del Área@(nodoActual is not null ? $": {nodoActual.Nombre}" : "")
            </h3>
            <small class="text-muted">Líneas de presupuesto y especificaciones</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center gap-1">
                <label class="small text-muted mb-0">Medidas:</label>
                <select class="form-select form-select-sm" style="width: auto;" @bind="unidadMedida" @bind:after="AlCambiarUnidadMedida">
                    <option value="mm">mm</option>
                    <option value="cm">cm</option>
                    <option value="m">m</option>
                </select>
            </div>
            @if (nodoActual is not null)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="VolverANodos">
                    Volver al Desglose
                </button>
            }
            @if (!mostrarFormulario)
            {
                <button class="btn btn-primary btn-sm" @onclick="AbrirFormularioNuevo">
                    + Nueva Partida
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger py-2">@mensajeError</div>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-bold">
                @(idEditando.HasValue ? "Editar Partida" : "Nueva Partida")
            </div>
            <div class="card-body">
                <EditForm Model="modeloFormulario" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="row g-2">
                        <div class="col-12 col-md-8">
                            <label class="form-label small mb-1">Descripción *</label>
                            <InputText class="form-control form-control-sm" @bind-Value="modeloFormulario.Descripcion" placeholder="Ej. Gabinete superior de cocina" />
                            <ValidationMessage For="@(() => modeloFormulario.Descripcion)" class="text-danger small" />
                        </div>

                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1">Cantidad</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="modeloFormulario.Cantidad" />
                            <ValidationMessage For="@(() => modeloFormulario.Cantidad)" class="text-danger small" />
                        </div>

                        <div class="col-6 col-md-2">
                            <label class="form-label small mb-1">Orden</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="modeloFormulario.Orden" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Material</label>
                            <InputText class="form-control form-control-sm" @bind-Value="modeloFormulario.Material" placeholder="Ej. Roble / MDF Hidrófugo" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small mb-1">Marca / Herrajes</label>
                            <InputText class="form-control form-control-sm" @bind-Value="modeloFormulario.Marca" placeholder="Ej. Blum" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small mb-1">Especificación</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="modeloFormulario.Especificacion" placeholder="Detalles técnicos o acabados..." />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small mb-1">Unidad de medida</label>
                            <select class="form-select form-select-sm" @bind="unidadMedida" @bind:after="AlCambiarUnidadMedida">
                                <option value="mm">Milímetros (mm)</option>
                                <option value="cm">Centímetros (cm)</option>
                                <option value="m">Metros (m)</option>
                            </select>
                        </div>

                        <div class="col-4 col-md-3">
                            <label class="form-label small mb-1">Ancho (@unidadMedida)</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="anchoEntrada" @bind-Value:after="SincronizarMedidasAMilimetros" />
                            <ValidationMessage For="@(() => modeloFormulario.AnchoMm)" class="text-danger small" />
                        </div>

                        <div class="col-4 col-md-3">
                            <label class="form-label small mb-1">Alto (@unidadMedida)</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="altoEntrada" @bind-Value:after="SincronizarMedidasAMilimetros" />
                            <ValidationMessage For="@(() => modeloFormulario.AltoMm)" class="text-danger small" />
                        </div>

                        <div class="col-4 col-md-3">
                            <label class="form-label small mb-1">Profundidad (@unidadMedida)</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="profundidadEntrada" @bind-Value:after="SincronizarMedidasAMilimetros" />
                            <ValidationMessage For="@(() => modeloFormulario.ProfundidadMm)" class="text-danger small" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small mb-1">Total Línea (Precio) *</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="modeloFormulario.TotalLinea" />
                            <ValidationMessage For="@(() => modeloFormulario.TotalLinea)" class="text-danger small" />
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label small mb-1">Descuento</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="modeloFormulario.Descuento" />
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label small mb-1">Costo Interno</label>
                            <InputNumber step="any" class="form-control form-control-sm" @bind-Value="modeloFormulario.CostoInterno" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small mb-1">Nota Interna (no visible al cliente)</label>
                            <InputText class="form-control form-control-sm" @bind-Value="modeloFormulario.NotaInterna" />
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-sm" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelarFormulario" disabled="@guardando">
                            Cancelar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (cargando)
    {
        <p class="text-muted">Cargando partidas...</p>
    }
    else if (partidas.Count == 0)
    {
        <div class="alert alert-light border text-center text-muted">
            No hay partidas registradas en esta área todavía.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Descripción y Detalles</th>
                        <th>Medidas (@unidadMedida)</th>
                        <th class="text-end">Cant.</th>
                        <th class="text-end">P. Unit.</th>
                        <th class="text-end">Total Línea</th>
                        <th style="width: 150px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in partidas)
                    {
                        <tr>
                            <td>@p.Orden</td>
                            <td>
                                <div class="fw-bold">@p.Descripcion</div>
                                @if (!string.IsNullOrWhiteSpace(p.Material) || !string.IsNullOrWhiteSpace(p.Marca))
                                {
                                    <div class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(p.Material))
                                        {
                                            <span>Mat: @p.Material</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.Marca))
                                        {
                                            <span class="ms-2">Marca: @p.Marca</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Especificacion))
                                {
                                    <div class="small text-secondary">@p.Especificacion</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.NotaInterna))
                                {
                                    <div class="small text-warning-emphasis"><em>Nota int: @p.NotaInterna</em></div>
                                }
                            </td>
                            <td class="small">
                                @if (p.AnchoMm.HasValue || p.AltoMm.HasValue || p.ProfundidadMm.HasValue)
                                {
                                    <span>@FormatearMedidaTabla(p.AnchoMm) x @FormatearMedidaTabla(p.AltoMm) x @FormatearMedidaTabla(p.ProfundidadMm) @unidadMedida</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end">@(p.Cantidad?.ToString("N2") ?? "-")</td>
                            <td class="text-end">@(p.PrecioUnitario?.ToString("N2") ?? "-")</td>
                            <td class="text-end fw-semibold">
                                @p.TotalLinea.ToString("N2")
                                @if (p.Descuento is > 0)
                                {
                                    <div class="small text-danger">Desc: -@p.Descuento.Value.ToString("N2")</div>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => AbrirFormularioEditar(p)">
                                    Editar
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarAsync(p.Id)">
                                    Borrar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="5" class="text-end">Subtotal Partidas:</td>
                        <td class="text-end">@partidas.Sum(x => x.TotalLinea - (x.Descuento ?? 0)).ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid NodoId { get; set; }

    private NodoDto? nodoActual;
    private List<PartidaDto> partidas = new();
    private bool cargando = true;
    private string? mensajeError;

    private bool mostrarFormulario = false;
    private bool guardando = false;
    private Guid? idEditando = null;
    private PartidaGuardarDto modeloFormulario = new();

    private string unidadMedida = "mm";
    private decimal? anchoEntrada;
    private decimal? altoEntrada;
    private decimal? profundidadEntrada;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            nodoActual = await ServicioNodos.ObtenerNodoPorIdAsync(NodoId);
            var resultado = await ServicioPartidas.ObtenerPartidasPorNodoAsync(NodoId);
            partidas = resultado ?? new List<PartidaDto>();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar las partidas: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormularioNuevo()
    {
        mensajeError = null;
        idEditando = null;
        modeloFormulario = new PartidaGuardarDto
        {
            NodoId = NodoId,
            Orden = partidas.Count + 1
        };
        CargarMedidasDesdeMilimetros();
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(PartidaDto partida)
    {
        mensajeError = null;
        idEditando = partida.Id;
        modeloFormulario = new PartidaGuardarDto
        {
            NodoId = partida.NodoId,
            Descripcion = partida.Descripcion,
            Especificacion = partida.Especificacion,
            Material = partida.Material,
            Marca = partida.Marca,
            Cantidad = partida.Cantidad,
            TotalLinea = partida.TotalLinea,
            AnchoMm = partida.AnchoMm,
            AltoMm = partida.AltoMm,
            ProfundidadMm = partida.ProfundidadMm,
            Descuento = partida.Descuento,
            CostoInterno = partida.CostoInterno,
            NotaInterna = partida.NotaInterna,
            Orden = partida.Orden
        };
        CargarMedidasDesdeMilimetros();
        mostrarFormulario = true;
    }

    private void AlCambiarUnidadMedida()
    {
        if (mostrarFormulario)
        {
            CargarMedidasDesdeMilimetros();
        }
    }

    private void CargarMedidasDesdeMilimetros()
    {
        anchoEntrada = ConvertirDesdeMilimetros(modeloFormulario.AnchoMm);
        altoEntrada = ConvertirDesdeMilimetros(modeloFormulario.AltoMm);
        profundidadEntrada = ConvertirDesdeMilimetros(modeloFormulario.ProfundidadMm);
    }

    private void SincronizarMedidasAMilimetros()
    {
        modeloFormulario.AnchoMm = ConvertirAMilimetros(anchoEntrada);
        modeloFormulario.AltoMm = ConvertirAMilimetros(altoEntrada);
        modeloFormulario.ProfundidadMm = ConvertirAMilimetros(profundidadEntrada);
    }

    private decimal? ConvertirDesdeMilimetros(int? valorMm)
    {
        if (!valorMm.HasValue) return null;

        return unidadMedida switch
        {
            "cm" => Math.Round(valorMm.Value / 10m, 2),
            "m" => Math.Round(valorMm.Value / 1000m, 3),
            _ => valorMm.Value
        };
    }

    private string FormatearMedidaTabla(int? valorMm)
    {
        var convertido = ConvertirDesdeMilimetros(valorMm);
        if (!convertido.HasValue) return "-";

        return convertido.Value.ToString("0.###");
    }

    private int? ConvertirAMilimetros(decimal? valorEntrada)
    {
        if (!valorEntrada.HasValue) return null;

        var milimetros = unidadMedida switch
        {
            "cm" => valorEntrada.Value * 10m,
            "m" => valorEntrada.Value * 1000m,
            _ => valorEntrada.Value
        };

        return (int)Math.Round(milimetros, MidpointRounding.AwayFromZero);
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        idEditando = null;
        mensajeError = null;
    }

    private async Task GuardarAsync()
    {
        SincronizarMedidasAMilimetros();
        guardando = true;
        mensajeError = null;

        try
        {
            if (idEditando.HasValue)
            {
                var (exito, error) = await ServicioPartidas.EditarPartidaAsync(idEditando.Value, modeloFormulario);
                if (!exito)
                {
                    mensajeError = error;
                    return;
                }
            }
            else
            {
                var (exito, error) = await ServicioPartidas.CrearPartidaAsync(modeloFormulario);
                if (!exito)
                {
                    mensajeError = error;
                    return;
                }
            }

            mostrarFormulario = false;
            idEditando = null;
            await CargarDatosAsync();
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarAsync(Guid id)
    {
        mensajeError = null;
        var (exito, error) = await ServicioPartidas.EliminarPartidaAsync(id);
        if (!exito)
        {
            mensajeError = error;
            return;
        }

        await CargarDatosAsync();
    }

    private void VolverANodos()
    {
        if (nodoActual is not null)
        {
            Navegacion.NavigateTo($"/proyectos/{nodoActual.ProyectoId}/nodos");
        }
    }
}