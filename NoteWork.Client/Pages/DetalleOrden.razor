    private async Task ImprimirAsync()
    {
        if (_pestana == PestanaVista.Items)
        {
            _pestana = PestanaVista.Presupuesto;
            StateHasChanged();
            await Task.Delay(60);
        }

        await JS.InvokeVoidAsync("window.print");
    }

    private ProductModelDto? ObtenerModelo(Guid modeloId) =>
        _catalogo?.Models.FirstOrDefault(m => m.Id == modeloId);

    private static string FormatearFechaHoraProfesional(DateTime fechaUtc)
    {
        var local = fechaUtc.ToLocalTime();
        var cultura = new CultureInfo("es-DO");
        var texto = local.ToString("dddd, dd/MM/yyyy · hh:mm tt", cultura);
        return string.IsNullOrEmpty(texto) ? texto : char.ToUpper(texto[0], cultura) + texto[1..];
    }

    private static string ResumenConfiguracionItem(WorkOrderItemDto item)
    {
        var partes = new List<string>();
        if (item.LeafCount > 0) partes.Add(item.LeafCount == 1 ? "1 hoja" : $"{item.LeafCount} hojas");
        if (item.DoorCount > 0) partes.Add(item.DoorCount == 1 ? "1 puerta" : $"{item.DoorCount} puertas");
        if (item.DrawerCount > 0) partes.Add(item.DrawerCount == 1 ? "1 gaveta" : $"{item.DrawerCount} gavetas");
        if (item.ShelfCount > 0) partes.Add(item.ShelfCount == 1 ? "1 repisa" : $"{item.ShelfCount} repisas");
        if (item.IsLowTrack) partes.Add("Riel bajo");
        return partes.Count == 0 ? "Configuración estándar" : string.Join(" · ", partes);
    }

    private static string EtiquetaUnidad(int cantidad, string etiqueta)
    {
        if (cantidad != 1) return etiqueta;
        return etiqueta.Trim().ToLowerInvariant() switch
        {
            "barras" => "barra",
            "planchas" => "plancha",
            "pies" => "pie",
            "unidades" => "unidad",
            _ => etiqueta
        };
    }

    private static string EtiquetaEstado(WorkOrderStatus estado) => estado switch
    {
        WorkOrderStatus.Draft => "Borrador",
        WorkOrderStatus.Quoted => "Cotizado",
        WorkOrderStatus.InProduction => "En Producción",
        WorkOrderStatus.Completed => "Completado",
        _ => estado.ToString()
    };

    private static string ClaseBadgeEstado(WorkOrderStatus estado) => estado switch
    {
        WorkOrderStatus.Draft => "bg-secondary",
        WorkOrderStatus.Quoted => "bg-info text-dark",
        WorkOrderStatus.InProduction => "bg-warning text-dark",
        WorkOrderStatus.Completed => "bg-success",
        _ => "bg-light text-dark"
    };
}