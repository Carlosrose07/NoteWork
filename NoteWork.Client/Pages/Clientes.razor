@page "/clientes"
@using Microsoft.AspNetCore.Authorization
@using NoteWork.Shared.Clientes
@using NoteWork.Client.Servicios

@* Exige sesión iniciada para ver esta pantalla *@
@attribute [Authorize]

@inject ServicioClientes ServicioClientes

<PageTitle>Clientes - NoteWork</PageTitle>

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-0 text-success fw-bold">Clientes</h2>
            <small class="text-muted">Directorio de clientes de tu empresa</small>
        </div>
        <a href="/clientes/nuevo" class="btn btn-success">
            + Nuevo Cliente
        </a>
    </div>
    <hr />

    <div class="input-group mb-3 shadow-sm">
        @* 
          @bind="_terminoBusqueda": conecta la variable con lo que escribe el usuario.
          @bind:event="oninput": actualiza letra por letra mientras escribe.
          @onkeyup="ManejarEnter": permite buscar presionando Enter en PC o "Ir" en el teclado del celular.
        *@
        <input type="text" class="form-control" placeholder="Buscar cliente por nombre..."
               @bind="_terminoBusqueda" @bind:event="oninput" @onkeyup="ManejarEnter" />

        @if (!string.IsNullOrWhiteSpace(_terminoBusqueda))
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusquedaAsync" title="Limpiar búsqueda">
                Limpiar
            </button>
        }

        <button class="btn btn-outline-success" type="button" @onclick="BuscarAsync">
            Buscar
        </button>
    </div>

    @if (_cargando && !_clientes.Any())
    {
        <div class="text-center my-4">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Cargando clientes...</p>
        </div>
    }
    else if (!_clientes.Any())
    {
        <div class="alert alert-light border text-center py-4">
            <p class="mb-2 fw-semibold">No se encontraron clientes.</p>
            <small class="text-muted">Prueba con otro nombre o registra un cliente nuevo.</small>
        </div>
    }
    else
    {
        @* 
          Rendimiento: Lista apilada ligera en lugar de <table>.
          Cada elemento es un enlace táctil amplio con fondo verde muy suave (#f7fcf9)
          para mantener coherencia visual con la tarjeta de Clientes en Inicio.
        *@
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var cliente in _clientes)
            {
                <a href="/clientes/editar/@cliente.Id"
                   class="text-decoration-none text-dark p-3 rounded shadow-sm d-flex justify-content-between align-items-center gap-2"
                   style="background-color: #f7fcf9; border: 1px solid #d5efe1;">
                    <div style="min-width: 0;">
                        <div class="fw-bold fs-6 text-break">@cliente.Nombre</div>
                        <small class="text-muted">
                            @(string.IsNullOrWhiteSpace(cliente.Telefono) ? "Sin teléfono registrado" : $"Tel: {cliente.Telefono}")
                        </small>
                    </div>
                    <span class="badge bg-white text-success border border-success-subtle text-nowrap">
                        Editar
                    </span>
                </a>
            }
        </div>

        @* Solo se muestra si la Api indicó que quedan más registros por descargar *@
        @if (_hayMas)
        {
            <div class="text-center mb-4">
                @* disabled="@_cargando": evita dobles clics mientras descarga la siguiente página *@
                <button class="btn btn-outline-success" @onclick="CargarMasAsync" disabled="@_cargando">
                    @(_cargando ? "Cargando..." : "Cargar más")
                </button>
            </div>
        }
    }
</div>

@code {
    private List<ClienteResumen> _clientes = new();
    private bool _cargando = true;
    private int _paginaActual = 1;
    private bool _hayMas = false;
    private string _terminoBusqueda = "";

    // Tope fijo para no saturar la memoria del teléfono al descargar registros.
    private const int TamanoPagina = 20;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientesAsync(reiniciar: true);
    }

    // Si reiniciar = true, limpia la lista y vuelve a la página 1.
    // Si reiniciar = false, conserva los elementos actuales y agrega la siguiente página.
    private async Task CargarClientesAsync(bool reiniciar = false)
    {
        _cargando = true;

        if (reiniciar)
        {
            _paginaActual = 1;
            _clientes.Clear();
        }

        var resultado = await ServicioClientes.ObtenerClientesAsync(_paginaActual, TamanoPagina, _terminoBusqueda);

        if (resultado != null)
        {
            _clientes.AddRange(resultado.Items);
            _hayMas = resultado.HayMas;
        }

        _cargando = false;
    }

    private async Task BuscarAsync()
    {
        await CargarClientesAsync(reiniciar: true);
    }

    private async Task LimpiarBusquedaAsync()
    {
        _terminoBusqueda = "";
        await CargarClientesAsync(reiniciar: true);
    }

    private async Task ManejarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarAsync();
        }
    }

    private async Task CargarMasAsync()
    {
        _paginaActual++;
        await CargarClientesAsync(reiniciar: false);
    }
}