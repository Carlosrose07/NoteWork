@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Inicio - NoteWork</PageTitle>

<div class="container mt-4">
    <AuthorizeView>
        <Authorized>
            <div class="mb-4">
                <h2 class="mb-1">Bienvenido a NoteWork</h2>
                <p class="text-muted mb-0">Selecciona un módulo para comenzar a trabajar.</p>
            </div>
            <hr />

            <div class="row g-3 mt-1">
                <!-- Acceso directo a Proyectos (fondo azul muy suave) -->
                <div class="col-12 col-md-6 col-lg-4">
                    <a href="proyectos" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm" style="background-color: #eef5ff; border: 1px solid #d4e4ff;">
                            <div class="card-body p-4">
                                <h5 class="card-title mb-2 fw-bold text-primary">Proyectos</h5>
                                <p class="card-text text-muted small mb-0">
                                    Gestiona presupuestos, áreas y partidas de cotización.
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Acceso directo a Clientes (fondo verde menta muy suave) -->
                <div class="col-12 col-md-6 col-lg-4">
                    <a href="clientes" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm" style="background-color: #eefaf3; border: 1px solid #cfefdc;">
                            <div class="card-body p-4">
                                <h5 class="card-title mb-2 fw-bold text-success">Clientes</h5>
                                <p class="card-text text-muted small mb-0">
                                    Consulta y registra los clientes de tu empresa.
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Acceso directo a Usuarios (fondo lavanda muy suave, solo visible para Admin) -->
                @if (context.User.IsInRole("Admin"))
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="usuarios" class="text-decoration-none text-dark">
                            <div class="card h-100 shadow-sm" style="background-color: #f4f1ff; border: 1px solid #dfd8ff;">
                                <div class="card-body p-4">
                                    <h5 class="card-title mb-2 fw-bold" style="color: #4b3f99;">Usuarios</h5>
                                    <p class="card-text text-muted small mb-0">
                                        Administra cuentas activas y contraseñas del equipo.
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</div>