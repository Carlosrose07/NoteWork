@page "/proyectos"
@using NoteWork.Shared.Proyecto
@using NoteWork.Shared.Comun
@using NoteWork.Client.Servicios
@inject ServicioProyectos ServicioProyectos
@inject NavigationManager NavigationManager
@* NUEVO: IJSRuntime nos permite mostrar el cuadro de confirmación nativo del navegador (ligero, funciona en iPhone) *@
@inject IJSRuntime JS

<PageTitle>Proyectos</PageTitle>

<h3>Proyectos</h3>

<div class="mb-3">
    @* Botón para ir al formulario de creación *@
    <button class="btn btn-primary" @onclick="IrACrearProyecto">Nuevo Proyecto</button>
</div>

@* NUEVO: mensaje de error si falla la eliminación (se muestra solo cuando hay texto) *@
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

@* Mientras la API responde, proyectos es null *@
@if (proyectos == null)
{
    <p><em>Cargando proyectos...</em></p>
}
@* Si ya respondió pero la lista vino vacía *@
else if (proyectos.Count == 0)
{
    <p>No hay proyectos registrados.</p>
}
else
{
    @* table-responsive evita que la tabla rompa la pantalla en celulares como el iPhone 11 *@
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @* Recorremos la lista de proyectos que extrajimos de PaginaResultado.Items *@
                @foreach (var proyecto in proyectos)
                {
                    <tr>
                        <td>@proyecto.Nombre</td>
                        @* Si ClienteNombre es null (porque ClienteId es opcional), mostramos un guion *@
                        <td>@(proyecto.ClienteNombre ?? "-")</td>
                        <td>@proyecto.Tipo</td>
                        <td>@proyecto.Estado</td>
                        <td>
                            @* flex-wrap: si no caben los 3 botones en la pantalla del celular, bajan a otra línea *@
                            <div class="d-flex flex-wrap gap-1">
                                <button class="btn btn-sm btn-info text-white" @onclick="() => IrANodos(proyecto.Id)">Desglose</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => IrAEditar(proyecto.Id)">Editar</button>
                                @* NUEVO: botón Eliminar. Se desactiva mientras ese proyecto se está eliminando
                                   para evitar dobles toques en el celular *@
                                <button class="btn btn-sm btn-danger"
                                        disabled="@(eliminandoId == proyecto.Id)"
                                        @onclick="() => EliminarProyecto(proyecto)">
                                    @(eliminandoId == proyecto.Id ? "Eliminando..." : "Eliminar")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // Lista donde guardaremos los elementos extraídos de PaginaResultado
    private List<ProyectoDto>? proyectos;

    // NUEVO: Id del proyecto que se está eliminando en este momento (null = ninguno)
    private Guid? eliminandoId;

    // NUEVO: texto del error que se muestra arriba de la tabla
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        // Llamamos a tu servicio que ya sabe cómo hablar con la API y pedir la página 1
        var resultado = await ServicioProyectos.ObtenerProyectosAsync();

        // Extraemos la propiedad Items (si resultado fuera null por algún fallo, creamos una lista vacía para no romper la pantalla)
        proyectos = resultado?.Items ?? new List<ProyectoDto>();
    }

    private void IrACrearProyecto()
    {
        // Navega a la ruta configurada en la línea 1 de EditarProyecto.razor
        NavigationManager.NavigateTo("/proyectos/crear");
    }

    private void IrAEditar(Guid id)
    {
        // Navega a la ruta configurada en la línea 2 de EditarProyecto.razor pasando el Guid
        NavigationManager.NavigateTo($"/proyectos/editar/{id}");
    }

    private void IrANodos(Guid id)
    {
        // Navega al desglose de Pisos, Apartamentos y Áreas del proyecto
        NavigationManager.NavigateTo($"/proyectos/{id}/nodos");
    }

    // NUEVO: elimina un proyecto después de pedir confirmación
    private async Task EliminarProyecto(ProyectoDto proyecto)
    {
        mensajeError = null;

        // 1. Cuadro de confirmación nativo. Si el usuario toca "Cancelar", no hacemos nada.
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar el proyecto \"{proyecto.Nombre}\"?");
        if (!confirmado) return;

        // 2. Marcamos este proyecto como "eliminando" (desactiva su botón)
        eliminandoId = proyecto.Id;

        try
        {
            // 3. Llamamos a la Api (DELETE api/proyectos/{id}). Devuelve true si salió bien.
            var exito = await ServicioProyectos.EliminarProyectoAsync(proyecto.Id);

            if (exito)
            {
                // 4. Lo quitamos de la lista en pantalla sin volver a pedir todo a la Api
                //    (más rápido y ligero para el iPhone 11)
                proyectos?.Remove(proyecto);
            }
            else
            {
                mensajeError = "No se pudo eliminar el proyecto. Intenta de nuevo.";
            }
        }
        catch (HttpRequestException)
        {
            // La Api en Render se duerme tras 15 min sin uso: el primer intento puede fallar
            mensajeError = "No se pudo conectar con el servidor. Espera unos segundos e intenta de nuevo.";
        }
        finally
        {
            // 5. Siempre reactivamos el botón al terminar, salga bien o mal
            eliminandoId = null;
        }
    }
}