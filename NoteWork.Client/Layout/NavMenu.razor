@* NavMenu.razor: menú lateral de NoteWork. *@

@using NoteWork.Client.Servicios
@inject ServicioSesion Sesion
@inject ServicioCatalogoUniversal Catalogo
@inject NavigationManager Navegador
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">NoteWork</a>
    </div>
</div>

<input type="checkbox" title="Menú de navegación" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        @if (_cargado)
        {
            @if (_haySesion)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="ordenes">
                        Órdenes
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="clientes">
                        Clientes
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="proyectos">
                        Proyectos
                    </NavLink>
                </div>

                @if (_esAdmin)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="catalogo">
                            Catálogo
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="usuarios">
                            Usuarios
                        </NavLink>
                    </div>
                }

                <div class="nav-item px-3">
                    <button class="nav-link" @onclick="CerrarSesionAsync">
                        Cerrar sesión
                    </button>
                </div>
            }
            else
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        Iniciar sesión
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private bool _cargado;
    private bool _haySesion;
    private bool _esAdmin;

    protected override async Task OnInitializedAsync()
    {
        Sesion.SesionCambio += AlSesionCambiar;
        await ActualizarAsync();
    }

    private async Task ActualizarAsync()
    {
        var datos = await Sesion.ObtenerSesionAsync();
        _haySesion = datos is not null;
        _esAdmin = datos?.Rol == "Admin";
        _cargado = true;
    }

    private void AlSesionCambiar()
    {
        _ = InvokeAsync(async () =>
        {
            await ActualizarAsync();
            StateHasChanged();
        });
    }

    private async Task CerrarSesionAsync()
    {
        Catalogo.InvalidarCache();
        await Sesion.CerrarSesionAsync();
        Navegador.NavigateTo("login");
    }

    public void Dispose()
    {
        Sesion.SesionCambio -= AlSesionCambiar;
    }
}